@PACKAGE_INIT@

# GSL::gsl sits in the exported target's link interface (LINK_ONLY for a
# static build); consumers need the imported target to already exist.
include(CMakeFindDependencyMacro)
find_dependency(GSL)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
